# This password must also appear in DATABASE_URL for host-side npm development
POSTGRES_PASSWORD=
WEB_PORT=8080

# Optional host-side npm development settings (ignored by deployed server).
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001
POSTGRES_PORT=5432
DATABASE_URL=postgresql://werewolf:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/werewolf_dev?schema=public

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
